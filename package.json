{
  "name": "physics2-learning-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Persian RTL interactive Physics II learning site built from the five lecture notes; fully static, GitHub Pages ready.",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:assets && npm run build:pages",
    "build:assets": "vite build",
    "build:pages": "node app/build/build.mjs",
    "coverage": "node app/build/build.mjs --coverage-only",
    "preview": "node app/build/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/site/physics.test.ts tests/site/content-integrity.test.mjs tests/site/math-render.test.mjs tests/site/content-numeric.test.mjs",
    "ci": "npm run typecheck && npm run test && npm run build && npm run test:consistency",
    "test:consistency": "node --test tests/site/internal-consistency.test.mjs",
    "audit:numbers": "node app/build/numeric-audit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "5.3.0",
    "katex": "0.16.22"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
